# Server
PORT=3000
NODE_ENV=development

# Optional: protect this integration API (Postman: x-api-key header)
INTEGRATION_API_KEY=

# Oracle Simphony STS Gen2 host (no trailing slash), e.g. https://your-tenant.oraclecloud.com
SIMPHONY_HOST=https://your-simphony-host.example.com

# OIDC / API account (from Simphony API account setup)
SIMPHONY_CLIENT_ID=
SIMPHONY_ORG_NAME=
SIMPHONY_API_USERNAME=
SIMPHONY_API_PASSWORD=

# Pre-loaded tokens (optional — skip sign-in if set; refresh still works)
SIMPHONY_ID_TOKEN=
SIMPHONY_REFRESH_TOKEN=

# Default location context for check operations (can override per request)
SIMPHONY_ORG_SHORT_NAME=
SIMPHONY_LOC_REF=
SIMPHONY_RVC_REF=

# Webhook HMAC (generate with: openssl rand -base64 32)
WEBHOOK_HMAC_KEY_ID=
WEBHOOK_HMAC_KEY=

# Forward received Simphony webhooks to webhook.site (dev/testing)
WEBHOOK_FORWARD_URL=https://webhook.site/283f6329-4f7a-4a97-bb56-5b1b065d4bef

# Public URL of this service (Railway), used when registering subscriptions
PUBLIC_BASE_URL=https://your-app.up.railway.app
